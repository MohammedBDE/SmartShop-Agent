# Copy this file to .env and fill in real values. .env is git-ignored.

# Anthropic (server-side only)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_ROUTER_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_MAX_TOKENS=1024
ANTHROPIC_MAX_RETRIES=3

# PostgreSQL (read by docker-compose and by the server)
# POSTGRES_PORT is the HOST port. 5433 avoids clashing with a native PostgreSQL on 5432.
POSTGRES_USER=shop
POSTGRES_PASSWORD=change_me
POSTGRES_DB=smart_shop
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Flask
FLASK_ENV=development
FLASK_PORT=5000

# RAG
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384
RAG_TOP_K=4
RAG_MIN_SCORE=0.25

# Conversational memory
MEMORY_MAX_MESSAGES=8
